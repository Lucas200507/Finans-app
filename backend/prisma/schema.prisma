generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Endereco {
  id Int @id @default(autoincrement())
  cep String
  estado String
  pais String
  complemento String?
  bairro String?
  numero String?
  cidade String
  created DateTime @default(now())
  modified DateTime @updatedAt
  usuarios Usuario[]
}

enum StatusUsuario {
  ATIVO
  INATIVO
  BLOQUEADO
}

model Usuario {
  id Int @id @default(autoincrement())
  nome String
  cpf String @unique
  telefone String
  email String @unique
  status StatusUsuario @default(ATIVO)
  senha String
  enderecoId Int
  created DateTime @default(now())
  modified DateTime @updatedAt
  endereco Endereco @relation(fields: [enderecoId], references: [id])
}