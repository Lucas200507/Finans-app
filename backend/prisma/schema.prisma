// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// ----- ETAPAS PARA RODAR A MIGRAÇÃO ------
// cd backend
// npx prisma migrate dev --name nome_da_migracao

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Endereco {
  id Int @id @default(autoincrement())
  cep String
  estado String
  pais String
  complemento String?
  bairro String?
  numero String?
  cidade String
  created DateTime @default(now())
  modified DateTime @updatedAt
  usuarios Usuario[]
  empresas Empresa[]
}

enum StatusUsuario {
  ATIVO
  INATIVO
  BLOQUEADO
}

model Usuario {
  id Int @id @default(autoincrement())
  nome String
  cpf String @unique
  telefone String
  email String @unique
  status StatusUsuario @default(ATIVO)
  senha String
  enderecoId Int?
  created DateTime @default(now())
  modified DateTime @updatedAt
  endereco Endereco? @relation(fields: [enderecoId], references: [id])
  empresaUsuarios Empresa_Usuario[]
}

enum StatusEmpresa {
  ATIVA
  INATIVA
  SUSPENSA
}


model Empresa {
  id Int @id @default(autoincrement())
  cnpj String @unique
  nome String
  enderecoId  Int
  telefone String 
  email String @unique
  status StatusEmpresa @default(ATIVA)
  created DateTime @default(now())
  modified DateTime @updatedAt
  endereco Endereco @relation(fields: [enderecoId], references: [id])
  empresaUsuarios Empresa_Usuario[]
}

enum PapelUsuario {
  CONTRIBUIDOR
  ADMINISTRADOR
  SOCIO
}

// Para um Adm ou Socio de empresa quiser convidar um novo integrante
enum StatusConvite {
  PENDENTE
  ACEITO
  RECUSADO
}

// @@unique -> combinacao de X e Y nao podem se repetir

model Empresa_Usuario {
  id        Int           @id @default(autoincrement())
  empresaId Int
  usuarioId Int
  papel     PapelUsuario  @default(CONTRIBUIDOR)
  status    StatusConvite @default(PENDENTE)
  created   DateTime      @default(now())
  modified  DateTime      @updatedAt
  empresa   Empresa       @relation(fields: [empresaId], references: [id])
  usuario   Usuario       @relation(fields: [usuarioId], references: [id])

  @@unique([empresaId, usuarioId])
}

model TipoPagamento {
  id        Int           @id @default(autoincrement())
  nome      String @unique
  aceitaParcelamento Boolean @default(true)  
  created   DateTime      @default(now())
  modified  DateTime      @updatedAt
}